# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Premium Investment Platform"

# Database (Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/investment_db"
DIRECT_URL="postgresql://postgres:password@localhost:5432/investment_db"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Email Service (Choose one)
# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourplatform.com

# Or SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourplatform.com

# SMS Service (Choose one)
# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Or MSG91
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=your-sender-id
MSG91_ROUTE=4

# Payment Gateways
# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Cron Job Security
CRON_SECRET=your-cron-job-secret-key

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# AWS S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Cloudinary (Alternative to S3)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Push Notifications
# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
FIREBASE_ADMIN_SDK_JSON=./firebase-admin-sdk.json

# OneSignal (Alternative)
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-rest-api-key

# Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Security
ENCRYPTION_KEY=your-encryption-key-32-characters
CORS_ORIGIN=http://localhost:3000

# Admin
ADMIN_EMAIL=admin@yourplatform.com
ADMIN_PASSWORD=change-this-secure-password

# Logging
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# App Settings
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_CURRENCY_CODE=INR
NEXT_PUBLIC_MIN_WITHDRAWAL=100
NEXT_PUBLIC_MAX_WITHDRAWAL=100000
NEXT_PUBLIC_WITHDRAWAL_FEE_PERCENT=2
NEXT_PUBLIC_REFERRAL_LEVEL_1_PERCENT=10
NEXT_PUBLIC_REFERRAL_LEVEL_2_PERCENT=5
NEXT_PUBLIC_REFERRAL_LEVEL_3_PERCENT=2

# Daily Income Cron
DAILY_INCOME_CRON_TIME=0 0 * * *
DAILY_INCOME_TIMEZONE=Asia/Kolkata

# Feature Flags
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_REFERRALS=true
NEXT_PUBLIC_MAINTENANCE_MODE=false
