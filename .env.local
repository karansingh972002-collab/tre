# Quick Start for Localhost

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Premium Investment Platform"

# Database - Supabase (Free, Easy Setup)
DATABASE_URL="postgresql://postgres:postgres@db.xxxx.supabase.co:5432/postgres"

# Or use local PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/investment_db"

# JWT Secrets
JWT_SECRET=my-super-secret-jwt-key-for-development-12345678
JWT_REFRESH_SECRET=my-refresh-token-secret-for-development-87654321
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# App Settings
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_CURRENCY_CODE=INR
NEXT_PUBLIC_MIN_WITHDRAWAL=100
NEXT_PUBLIC_MAX_WITHDRAWAL=100000
NEXT_PUBLIC_WITHDRAWAL_FEE_PERCENT=2
NEXT_PUBLIC_REFERRAL_LEVEL_1_PERCENT=10
NEXT_PUBLIC_REFERRAL_LEVEL_2_PERCENT=5
NEXT_PUBLIC_REFERRAL_LEVEL_3_PERCENT=2

# Feature Flags
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_REFERRALS=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Optional Services (Can be configured later)
# Email, SMS, Payment gateways can be added when needed
